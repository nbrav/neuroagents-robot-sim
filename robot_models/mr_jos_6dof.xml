<mujoco model="Mr Jos inspired six-axis arm (approximate mechanics)">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual><global offwidth="1000" offheight="800"/><headlight ambient="0.4 0.4 0.4"/></visual>
  <default>
    <joint damping="0.06" armature="0.004"/>
    <geom friction="0.7 0.01 0.001" rgba="0.9 0.7 0.05 1"/>
    <motor gear="1" ctrllimited="true" ctrlrange="-2 2"/>
  </default>
  <worldbody>
    <light pos="0 -1 2"/>
    <geom name="floor" type="plane" size="1 1 .1" rgba=".83 .85 .88 1"/>
    <body name="support">
      <geom name="base" type="box" pos="0 0 .035" size=".10 .10 .035" rgba=".2 .2 .22 1"/>
      <geom name="pedestal" type="box" pos="0 0 .11" size=".045 .045 .055" rgba=".35 .35 .38 1"/>
    </body>
    <body name="base_yaw" pos="0 0 .165">
      <joint name="j1_base_yaw" axis="0 0 1"/>
      <geom type="cylinder" size=".045 .018" mass=".12" rgba=".25 .25 .28 1"/>
      <!-- q2=0 holds the 168 mm upper arm vertically. -->
      <body name="shoulder" euler="0 -1.5707963267948966 0">
        <joint name="j2_shoulder" axis="0 -1 0" limited="true" range="-1.658063 .767945"/>
        <geom type="box" pos=".084 -.022 0" size=".084 .008 .012" mass=".09"/>
        <geom type="box" pos=".084 .022 0" size=".084 .008 .012" mass=".09"/>
        <geom type="cylinder" euler="1.57079632679 0 0" size=".028 .032" mass=".08" rgba=".25 .25 .28 1"/>
        <body name="elbow" pos=".168 0 0">
          <joint name="j3_elbow" axis="0 1 0" limited="true" range="-.9 1.8"/>
          <geom type="capsule" fromto="0 0 0 .047 0 0" size=".015" mass=".06"/>
          <!-- 47 mm offset, then 152 mm along the forearm roll axis. -->
          <body name="forearm_roll" pos=".047 0 0" euler="0 1.5707963267948966 0">
            <joint name="j4_arm_roll" axis="-1 0 0"/>
            <geom type="box" pos=".076 0 0" size=".076 .018 .018" mass=".13"/>
            <geom type="cylinder" euler="0 1.57079632679 0" size=".025 .018" mass=".04" rgba=".25 .25 .28 1"/>
            <body name="wrist" pos=".152 0 0">
              <joint name="j5_wrist" axis="0 1 0" limited="true" range="-1.5 1.5"/>
              <geom type="sphere" size=".022" mass=".04" rgba=".3 .3 .32 1"/>
              <body name="tool_roll">
                <joint name="j6_tool_roll" axis="1 0 0"/>
                <geom type="capsule" fromto="0 0 0 .085 0 0" size=".009" mass=".025" rgba=".4 .4 .42 1"/>
                <geom type="box" pos=".085 0 0" size=".005 .028 .006" mass=".008" rgba=".25 .25 .28 1"/>
                <geom type="box" pos=".1 -.023 0" size=".015 .005 .006" mass=".004" rgba=".25 .25 .28 1"/>
                <geom type="box" pos=".1 .023 0" size=".015 .005 .006" mass=".004" rgba=".25 .25 .28 1"/>
                <site name="tool_tip" pos=".115 0 0" size=".007" rgba="0 1 0 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <body name="target" mocap="true" pos=".267 0 .38">
      <geom type="sphere" size=".012" rgba="1 .85 0 .7" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 .06 0 0" size=".002" rgba="1 .1 .1 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 .06 0" size=".002" rgba=".1 1 .1 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 .06" size=".002" rgba=".1 .3 1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <contact>
    <exclude body1="support" body2="base_yaw"/>
    <exclude body1="support" body2="shoulder"/>
    <exclude body1="base_yaw" body2="elbow"/>
    <exclude body1="shoulder" body2="forearm_roll"/>
    <exclude body1="elbow" body2="wrist"/>
    <exclude body1="elbow" body2="tool_roll"/>
    <exclude body1="forearm_roll" body2="tool_roll"/>
  </contact>
  <!-- Unit gearing: ctrl is an output-joint torque in Nm, not an EV3 motor command. -->
  <actuator>
    <motor name="m1" joint="j1_base_yaw"/>
    <motor name="m2" joint="j2_shoulder"/>
    <motor name="m3" joint="j3_elbow"/>
    <motor name="m4" joint="j4_arm_roll" ctrlrange="-.6 .6"/>
    <motor name="m5" joint="j5_wrist" ctrlrange="-.6 .6"/>
    <motor name="m6" joint="j6_tool_roll" ctrlrange="-.3 .3"/>
  </actuator>
</mujoco>
